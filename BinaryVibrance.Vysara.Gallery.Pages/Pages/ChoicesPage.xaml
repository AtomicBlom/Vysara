<?xml version="1.0" encoding="utf-8"?>
<!--
	Choices: a ComboBox and RadioButtons bound TwoWay to the same index, RadioButtons grouped by name, a NumberBox and a
	ToggleSwitch echoed by a line under them, an Expander, and an InfoBar of each severity that close and come back.
-->
<Border xmlns="https://github.com/AtomicBlom/Vysara/ui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BinaryVibrance.Vysara.Gallery"
        x:Class="BinaryVibrance.Vysara.Gallery.Pages.ChoicesPage"
        Padding="28">
	<StackPanel Orientation="Vertical">
		<TextBlock Text="Choices" Style="{x:Static local:GalleryTheme.PageTitle}" />
		<TextBlock Text="Picking one of several, numbers, switches, and what folds away or speaks up."
		           Style="{x:Static local:GalleryTheme.PageSummary}" />

		<!-- The ComboBox and the RadioButtons share one index, so choosing in either moves the other -->
		<TextBlock Text="ComboBox &amp; RadioButtons" Style="{x:Static local:GalleryTheme.SectionHeading}" />
		<Border Style="{x:Static local:GalleryTheme.Card}">
			<StackPanel Orientation="Vertical">
				<StackPanel Orientation="Horizontal" Margin="0,0,0,14">
					<ComboBox Header="Weather" ItemsSource="{x:Bind Weathers}" SelectedIndex="{x:Bind Weather, Mode=TwoWay}"
					          PlaceholderText="Pick the weather" Width="200" Margin="0,0,32,0" />
					<RadioButtons Header="The same choice" ItemsSource="{x:Bind Weathers}" SelectedIndex="{x:Bind Weather, Mode=TwoWay}" MaxColumns="2" />
				</StackPanel>
				<TextBlock Text="RadioButtons grouped by GroupName, outside a RadioButtons" Style="{x:Static local:GalleryTheme.Note}" Margin="0,0,0,6" />
				<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
					<RadioButton Content="Dawn" GroupName="Time" Margin="0,0,16,0" />
					<RadioButton Content="Day" GroupName="Time" IsChecked="true" Margin="0,0,16,0" />
					<RadioButton Content="Dusk" GroupName="Time" />
				</StackPanel>
				<TextBlock Text="{x:Bind WeatherLabel, Mode=OneWay}" Style="{x:Static local:GalleryTheme.Body}" />
			</StackPanel>
		</Border>

		<TextBlock Text="NumberBox &amp; ToggleSwitch" Style="{x:Static local:GalleryTheme.SectionHeading}" />
		<Border Style="{x:Static local:GalleryTheme.Card}">
			<StackPanel Orientation="Vertical">
				<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
					<NumberBox Header="Laps" Minimum="1" Maximum="99" Value="{x:Bind Laps, Mode=TwoWay}"
					           Width="140" Margin="0,0,32,0" />
					<ToggleSwitch Header="Ghosts" IsOn="{x:Bind Ghosts, Mode=TwoWay}" OnContent="Shown" OffContent="Hidden" Margin="0,0,32,0" />
					<ToggleSwitch Header="Disabled" IsEnabled="false" />
				</StackPanel>
				<TextBlock Text="{x:Bind RaceLabel, Mode=OneWay}" Style="{x:Static local:GalleryTheme.Body}" Margin="0,0,0,4" />
				<TextBlock Text="Laps take 1 to 99: type a number, or use the arrows, Page Up and Page Down, or the wheel."
				           Style="{x:Static local:GalleryTheme.Note}" TextWrapping="Wrap" />
			</StackPanel>
		</Border>

		<TextBlock Text="Expander" Style="{x:Static local:GalleryTheme.SectionHeading}" />
		<Border Style="{x:Static local:GalleryTheme.Card}">
			<StackPanel Orientation="Vertical">
				<Expander Header="Tyres" IsExpanded="true" Margin="0,0,0,8">
					<TextBlock Text="Grip 1.05, wear off, warm-up 30 s" Style="{x:Static local:GalleryTheme.Body}" />
				</Expander>
				<Expander Header="Assists (folded)">
					<TextBlock Text="Traction control, ABS and steering help" Style="{x:Static local:GalleryTheme.Body}" />
				</Expander>
			</StackPanel>
		</Border>

		<TextBlock Text="InfoBar" Style="{x:Static local:GalleryTheme.SectionHeading}" />
		<Border Style="{x:Static local:GalleryTheme.Card}">
			<StackPanel Orientation="Vertical">
				<InfoBar x:Name="Informational" Title="Saved" Message="Your settings are kept between runs." Severity="Informational" IsOpen="true" Margin="0,0,0,6" />
				<InfoBar x:Name="Success" Title="Built" Message="Compiled in 812 ms." Severity="Success" IsOpen="true" Margin="0,0,0,6" />
				<InfoBar x:Name="Warning" Title="Slow" Message="The last frame took 41 ms." Severity="Warning" IsOpen="true" Margin="0,0,0,6" />
				<InfoBar x:Name="Error" Title="Failed" Message="The file couldn't be read." Severity="Error" IsOpen="true" IsClosable="false" Margin="0,0,0,10">
					<InfoBar.ActionButton>
						<Button Content="Try again" Click="OnReopen" />
					</InfoBar.ActionButton>
				</InfoBar>
				<Button Content="Open them all again" Click="OnReopen" HorizontalAlignment="Left" />
			</StackPanel>
		</Border>
	</StackPanel>
</Border>
