<Project>

  <!--
    SUIsei XAML build machinery — targets.

    Imported AFTER the project body (so $(SUIseiXamlSourceDir) is already set). Does two things:
      1. Registers every *.xaml under the project as <AdditionalFiles> so the SUIsei.SourceGen incremental
         generator's AdditionalTextsProvider can see them, and as <UpToDateCheckInput> so the IDE
         fast-up-to-date check never serves a stale generated tree after a .xaml edit (the same rationale as
         the shader UpToDateCheckInput in SUIsei.Shaders.targets).
      2. References SUIsei.SourceGen as a build-time ANALYZER (OutputItemType=Analyzer,
         ReferenceOutputAssembly=false) — it emits the partial x:Class with typed x:Name fields and
         InitializeComponent(); it is never a runtime dependency.

    The .xaml glob lives in a top-level ItemGroup (evaluated before any target runs), so it is populated even
    though this file is imported at the bottom of the consuming project.
  -->

  <PropertyGroup>
    <_SUIseiUISourceGen>$(SUIseiUIRepoRoot)SUIsei.SourceGen\SUIsei.SourceGen.csproj</_SUIseiUISourceGen>
  </PropertyGroup>

  <ItemGroup Condition="'$(SUIseiXamlEnable)' == 'true'">
    <!-- Recurse the source dir, excluding the build output trees and whatever the project keeps out of its default
         item globs (DefaultItemExcludes, and DefaultExcludesInProjectFolder's hidden folders, such as .git and
         .claude/worktrees checkouts), as its Compile glob does: a project that holds another repository's
         projects beneath it, such as a submodule with views of its own, excludes them there once. The .xaml
         sources exist at evaluation, so a static glob is correct here (unlike the shaders' generated .spv, which
         must be registered in a target). -->
    <SUIseiXaml Include="$(SUIseiXamlSourceDir)\**\*.xaml"
              Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);$(MSBuildProjectDirectory)\obj\**\*.xaml;$(MSBuildProjectDirectory)\bin\**\*.xaml" />
    <AdditionalFiles Include="@(SUIseiXaml)" />
    <UpToDateCheckInput Include="@(SUIseiXaml)" />
    <!-- dotnet watch does not monitor AdditionalFiles by default; opt the .xaml in so a `dotnet watch` loop
         re-runs the generator on edit, feeding XAML Hot Reload. -->
    <Watch Include="@(SUIseiXaml)" />
  </ItemGroup>

  <!-- The generator is inert until the analyzer project exists (mirrors the _SUIseiWarnInertDirectX12 pattern in
       Sdk.targets): reference it only when the file is present, so the flag can be on without breaking a build
       that lacks the generator. -->
  <ItemGroup Condition="'$(SUIseiXamlEnable)' == 'true' And Exists('$(_SUIseiUISourceGen)')">
    <!-- UndefineProperties strips a consuming project's publish/runtime properties from this reference: the
         generator is a build-time analyzer (netstandard2.0), so an AOT-published consumer must not try to
         AOT-compile it (NETSDK1207) — nor build it for the consumer's RID / self-contained mode. -->
    <ProjectReference Include="$(_SUIseiUISourceGen)" OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      UndefineProperties="PublishAot;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <!-- No diagnostics in a browser: their endpoint (SUIsei.Diagnostics.Endpoint) listens on a named pipe and loads a
       tap's assembly by name, neither of which a page can do. The switch is set false there whatever the app asked
       for, and set at all so the trimmer can see it is off and remove the code it guards (Diagnostics.Enabled); left
       unset, the trimmer has to keep that code. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <RuntimeHostConfigurationOption Remove="SUIsei.Diagnostics.Enabled" />
    <RuntimeHostConfigurationOption Include="SUIsei.Diagnostics.Enabled" Value="false" Trim="true" />
  </ItemGroup>

  <Target Name="_SUIseiWarnMissingXamlGen"
          BeforeTargets="ResolveProjectReferences"
          Condition="'$(SUIseiXamlEnable)' == 'true' And !Exists('$(_SUIseiUISourceGen)')">
    <Warning Text="SUIseiXamlEnable=true but SUIsei.SourceGen does not exist at '$(_SUIseiUISourceGen)'; .xaml views will not be code-generated." />
  </Target>

</Project>
