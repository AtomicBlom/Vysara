<Project>

  <!--
    SUIsei NuGet consumer build targets.

    Auto-imported by MSBuild when a project references the SUIsei NuGet package. The generator DLL itself is in
    analyzers/dotnet/cs/ in this package, and NuGet wires it as an analyzer automatically; this file registers the
    .xaml it reads, as the source build's build/SUIsei.targets does. Every *.xaml under the project (or under
    $(SUIseiXamlSourceDir)), except the build output and whatever the project keeps out of its default item globs
    (DefaultItemExcludes), becomes:
      - <AdditionalFiles>, so the bundled SUIsei.SourceGen generator produces the typed control tree and compiled
        x:Bind glue;
      - <UpToDateCheckInput>, so the IDE's fast up-to-date check never serves a stale tree after an edit;
      - <Watch>, so a `dotnet watch` loop re-runs the generator on edit, feeding XAML Hot Reload.
    SUIseiXamlEnable=false opts a build out of the registration.
  -->

  <PropertyGroup>
    <SUIseiXamlEnable Condition="'$(SUIseiXamlEnable)' == ''">true</SUIseiXamlEnable>
    <SUIseiXamlSourceDir Condition="'$(SUIseiXamlSourceDir)' == ''">$(MSBuildProjectDirectory)</SUIseiXamlSourceDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(SUIseiXamlEnable)' == 'true'">
    <SUIseiXaml Include="$(SUIseiXamlSourceDir)\**\*.xaml"
               Exclude="$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**\*.xaml;$(MSBuildProjectDirectory)\bin\**\*.xaml" />
    <AdditionalFiles Include="@(SUIseiXaml)" />
    <UpToDateCheckInput Include="@(SUIseiXaml)" />
    <Watch Include="@(SUIseiXaml)" />
  </ItemGroup>

</Project>
