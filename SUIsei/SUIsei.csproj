<Project Sdk="Microsoft.NET.Sdk">

  <!-- XAML -> typed control-tree generator wiring (registers *.xaml as AdditionalFiles + the analyzer ref). -->
  <Import Project="..\build\SUIsei.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NativeAOT gate: turns on the trim + AOT Roslyn analyzers so any reflection or AOT-unsafe pattern
         surfaces as a build warning. The UI runtime is NAOT-clean by design (compiled x:Bind, typed DP
         delegates, no Activator/MethodInfo). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>SUIsei</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Authors>AtomicBlom</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AtomicBlom/SUIsei</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AtomicBlom/SUIsei</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Retained-mode WinUI-like control tree and compositor for .NET. NativeAOT-clean, XAML-driven, with an incremental Roslyn source generator bundled in this package.</Description>
    <PackageTags>ui;xaml;winui;gamedev;dotnet;naot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSymbols>true</IncludeSymbols>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- SUIsei is standalone — no Loom.Core or Loom.Assets reference. The only external dependency is
       StbImageSharp for decoding the embedded MTSDF font atlas PNG. Engine glue lives in Loom.UI.SUIsei. -->
  <ItemGroup>
    <PackageReference Include="StbImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SUIsei.Tests" />
  </ItemGroup>

  <!-- The engine's default baked font: the MTSDF atlas page + its JSON layout, embedded so FontAtlas.LoadEmbeddedDefault
       resolves them with no loose files. Explicit LogicalName because the filenames carry dots. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\ui-default.font.json" LogicalName="ui-default.font.json" />
    <EmbeddedResource Include="Assets\Fonts\ui-default.0.png" LogicalName="ui-default.0.png" />
    <None Include="Assets\Fonts\CascadiaCode.ttf" />
    <None Include="Assets\Fonts\CascadiaCode-LICENSE.txt" />
  </ItemGroup>

  <Import Project="..\build\SUIsei.targets" />

  <!-- NuGet packaging: bundle SUIsei.SourceGen.dll in analyzers/dotnet/cs so consumers get both the runtime
       and the XAML incremental generator from a single <PackageReference Include="SUIsei" />.
       The generator is already built as a dependency (via SUIsei.targets' ProjectReference); this target just
       hoists its netstandard2.0 output into the package at the right path. -->
  <ItemGroup>
    <None Include="..\SUIsei.SourceGen\bin\$(Configuration)\netstandard2.0\SUIsei.SourceGen.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- Consumer-facing build targets: registers *.xaml as AdditionalFiles so the bundled generator sees them. -->
    <None Include="pkg\build\SUIsei.targets"
          Pack="true" PackagePath="build" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
