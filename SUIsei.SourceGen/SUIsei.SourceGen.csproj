<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The XAML -> typed control-tree Roslyn incremental generator (PlanningUI.md §D1.4). A build-time analyzer,
    never a runtime dependency: it targets netstandard2.0 (the analyzer-host TFM) and ships its assembly only
    (IncludeBuildOutput=false; the Roslyn package is PrivateAssets=all so it isn't a transitive ref).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>false</IsPackable>
    <!-- Release-tracking (RS2008) is for shipped analyzer packages; this generator is a private build-time component. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
