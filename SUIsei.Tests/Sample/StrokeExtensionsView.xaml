<?xml version="1.0" encoding="utf-8"?>
<!--
	The suisei: stroke extensions end to end: a polyline drawn on by a storyboard on (suisei:StrokeTrim.End), its gradient
	running along its length (suisei:StrokeBrushMapping.Mode="AlongLength"). SUIsei.SourceGen turns it into a partial
	SUIsei.Tests.Sample.StrokeExtensionsView at build time; StrokeExtensionsTests runs the storyboard and checks the pixels.
-->
<StackPanel xmlns="https://github.com/AtomicBlom/SUIsei/ui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:suisei="https://github.com/AtomicBlom/SUIsei/extensions"
            x:Class="SUIsei.Tests.Sample.StrokeExtensionsView">
	<Canvas Width="100" Height="100">
		<Polyline x:Name="Trail" Points="10,50 50,50 50,90" StrokeThickness="6"
		          suisei:StrokeTrim.End="0" suisei:StrokeBrushMapping.Mode="AlongLength">
			<Polyline.Stroke>
				<LinearGradientBrush ColorInterpolationMode="ScRgbLinearInterpolation">
					<GradientStop Color="#FF0000" Offset="0" />
					<GradientStop Color="#00FF00" Offset="0.5" />
					<GradientStop Color="#0000FF" Offset="1" />
				</LinearGradientBrush>
			</Polyline.Stroke>
		</Polyline>
	</Canvas>
	<ContentControl x:Name="Host">
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup Name="Reveal">
				<VisualState Name="Hidden" />
				<VisualState Name="Drawn">
					<Storyboard>
						<DoubleAnimation Storyboard.TargetName="Trail" Storyboard.TargetProperty="(suisei:StrokeTrim.End)"
						                 To="1" Duration="0:0:1" />
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
	</ContentControl>
</StackPanel>
