<?xml version="1.0" encoding="utf-8"?>
<!--
	Layout-property fixture. SUIsei.SourceGen turns this into a partial SUIsei.Tests.Sample.LayoutPropertiesView at build
	time; LayoutPropertyTests runs it. A style sets every FrameworkElement layout property, Border's Padding and
	BorderThickness, and Tag; a local value outranks it whether it is written before the style or after; a style resets
	Width to Auto; Tag takes an x:Bind; and a visual state animates (FrameworkElement.Width) and Height, which re-lays out.
-->
<StackPanel xmlns="https://github.com/AtomicBlom/SUIsei/ui"
			xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			x:Class="SUIsei.Tests.Sample.LayoutPropertiesView">
	<StackPanel.Resources>
		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Width" Value="120" />
			<Setter Property="Height" Value="40" />
			<Setter Property="MinWidth" Value="10" />
			<Setter Property="MinHeight" Value="5" />
			<Setter Property="MaxWidth" Value="300" />
			<Setter Property="MaxHeight" Value="80" />
			<Setter Property="Margin" Value="4,6,8,10" />
			<Setter Property="Padding" Value="3" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="HorizontalAlignment" Value="Left" />
			<Setter Property="VerticalAlignment" Value="Top" />
			<Setter Property="Tag" Value="card" />
		</Style>
		<Style x:Key="AutoWidthCard" TargetType="Border" BasedOn="{StaticResource Card}">
			<Setter Property="Width" Value="Auto" />
		</Style>
	</StackPanel.Resources>
	<Border x:Name="Styled" Style="{StaticResource Card}" />
	<Border x:Name="LocalFirst" Width="60" HorizontalAlignment="Stretch" Style="{StaticResource Card}" />
	<Border x:Name="LocalAfter" Style="{StaticResource Card}" Width="70" />
	<Border x:Name="AutoWidth" Style="{StaticResource AutoWidthCard}" />
	<Border x:Name="Tagged" Tag="{x:Bind TagText}" Height="Auto" />
	<Border x:Name="Grower" Width="100" Height="10" HorizontalAlignment="Left" />
	<ContentControl x:Name="Host">
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup x:Name="Size">
				<VisualState x:Name="Narrow" />
				<VisualState x:Name="Wide">
					<Storyboard>
						<DoubleAnimation Storyboard.TargetName="Grower" Storyboard.TargetProperty="(FrameworkElement.Width)"
										 To="200" Duration="0:0:1" />
						<DoubleAnimation Storyboard.TargetName="Grower" Storyboard.TargetProperty="Height"
										 From="20" To="40" Duration="0:0:1" />
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
	</ContentControl>
</StackPanel>
