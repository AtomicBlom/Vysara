<?xml version="1.0" encoding="utf-8"?>
<!--
	Exercises the three [ContentProperty] content models in one tree: ScrollViewer.Content (scalar), Panel.Children
	(collection), and Border.Child (scalar) — all resolved from the [ContentProperty] attribute on the control, not
	a hardcoded name.
-->
<ScrollViewer xmlns="https://github.com/AtomicBlom/SUIsei/ui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              x:Class="SUIsei.Tests.Sample.ContentModelView">
	<StackPanel x:Name="Stack" Orientation="Vertical">
		<Border x:Name="Box">
			<TextBlock x:Name="Label" Text="hi" />
		</Border>
		<TextBlock x:Name="Second" Text="two" />
	</StackPanel>
</ScrollViewer>
