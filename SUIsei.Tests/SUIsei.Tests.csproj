<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\build\SUIsei.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Shouldly" />
    <!-- Drive SUIsei.SourceGen directly (CSharpGeneratorDriver) to unit-test the diagnostics and incremental
         caching that the build-time analyzer path can't exercise (invalid XAML would break this project's own build). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <!-- SUIsei is standalone — only the runtime project is needed (no Loom.Core / Loom.Assets). -->
  <!-- ReferenceOutputAssembly=true on SourceGen so XamlSourceGenerator is referenceable by CSharpGeneratorDriver tests. -->
  <ItemGroup>
    <ProjectReference Include="..\SUIsei\SUIsei.csproj" />
    <ProjectReference Include="..\SUIsei.SourceGen\SUIsei.SourceGen.csproj" ReferenceOutputAssembly="true" />
    <!-- The CPU reference rasterizer is the headless pixel oracle: it renders DrawListData to RGBA8 with the same
         per-kind math (and the RT-stack layer composite) the GPU runs, so group opacity is asserted at the pixel
         level with no GPU. -->
    <ProjectReference Include="..\SUIsei.Rasterizer\SUIsei.Rasterizer.csproj" />
  </ItemGroup>

  <Import Project="..\build\SUIsei.targets" />

</Project>
