<?xml version="1.0" encoding="utf-8"?>
<!--
	Hot-reload fixture for a view nested in another view's XAML. The root is an unsealed ContentControl, so a rebuild runs
	InitializeComponent again on the same object: NestingView places it between two siblings, and it has to stay there.
-->
<ContentControl xmlns="https://github.com/AtomicBlom/Vysara/ui"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				x:Class="Vysara.Tests.Sample.CounterPanel">
	<Border>
		<TextBlock x:Name="Label" Text="count" />
	</Border>
</ContentControl>
