<?xml version="1.0" encoding="utf-8"?>
<!--
	Inherited text properties. Two tabs share one ControlTemplate kept as a resource: its ContentPresenter sizes and paints
	the label, and its Lit and Dim states, written first as WinUI templates write them, animate the presenter's brush. The
	label is string content, a TextBlock the presenter makes, which inherits both; each tab's template has a brush of its
	own. A third tab takes its template from a style, its presenter sizing the label and passing on the tab's brush. A
	card passes its FontSize and Foreground through a StackPanel and a Border to the TextBlocks in its element content; a
	TextBlock with its own value, or a style's, keeps it.
-->
<StackPanel xmlns="https://github.com/AtomicBlom/Vysara/ui"
			xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			x:Class="Vysara.Tests.Sample.InheritedTextView">
	<StackPanel.Resources>
		<ControlTemplate x:Key="TabTemplate" TargetType="ContentControl">
			<Border Padding="6,2">
				<VisualStateManager.VisualStateGroups>
					<VisualStateGroup x:Name="Emphasis">
						<VisualState x:Name="Lit">
							<Storyboard>
								<ColorAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="(ContentPresenter.Foreground).(SolidColorBrush.Color)" To="#FFFFFF" Duration="0:0:0.2" />
							</Storyboard>
						</VisualState>
						<VisualState x:Name="Dim">
							<Storyboard>
								<ColorAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="(ContentPresenter.Foreground).(SolidColorBrush.Color)" To="#606060" Duration="0:0:0.2" />
							</Storyboard>
						</VisualState>
					</VisualStateGroup>
				</VisualStateManager.VisualStateGroups>
				<ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" FontSize="20" Foreground="#606060" />
			</Border>
		</ControlTemplate>
		<Style x:Key="TabStyle" TargetType="ContentControl">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate>
						<ContentPresenter Content="{TemplateBinding Content}" FontSize="16" />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="Small" TargetType="TextBlock">
			<Setter Property="FontSize" Value="9" />
		</Style>
	</StackPanel.Resources>
	<ContentControl x:Name="Tab" Content="Track" Template="{StaticResource TabTemplate}" />
	<ContentControl x:Name="OtherTab" Content="Map" Template="{StaticResource TabTemplate}" />
	<ContentControl x:Name="StyledTab" Content="Laps" Foreground="Gold" Style="{StaticResource TabStyle}" />
	<ContentControl x:Name="Card" FontSize="18" Foreground="Gold">
		<StackPanel>
			<TextBlock x:Name="Title" Text="Inherits" />
			<Border>
				<TextBlock x:Name="Nested" Text="Through a border" />
			</Border>
			<TextBlock x:Name="Own" Text="Own" FontSize="11" Foreground="Teal" TextAlignment="End" />
			<TextBlock x:Name="Styled" Text="Styled" Style="{StaticResource Small}" />
		</StackPanel>
	</ContentControl>
</StackPanel>
