<?xml version="1.0" encoding="utf-8"?>
<!--
	Storyboard end-to-end fixture. Vysara.SourceGen turns this into a partial Vysara.Tests.Sample.AnimationView at build
	time, so its compilation proves the emitted storyboards are valid C#; AnimationViewTests then runs them. It covers
	Storyboard.TargetProperty paths to an attached property, an owner-qualified property and a WinUI brush path, plus a
	keyframe animation with discrete and eased keys. The Fader's states are WinUI's pattern for showing and hiding: Hidden
	fades the panel out and collapses it as the fade ends, Shown makes it visible at once and fades it in. Marked sets a
	brush, from a resource and from an object, and text, through discrete object keys.
-->
<StackPanel xmlns="https://github.com/AtomicBlom/Vysara/ui"
			xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			x:Class="Vysara.Tests.Sample.AnimationView"
			Orientation="Vertical">
	<Canvas Width="200" Height="40">
		<Border x:Name="Box" Width="20" Height="20" Background="#FF0000" />
	</Canvas>
	<Border x:Name="Panel" Width="40" Height="20" Background="#00FF00">
		<TextBlock x:Name="Caption" Text="Plain" />
	</Border>
	<ContentControl x:Name="Fader">
		<ContentControl.Resources>
			<SolidColorBrush x:Key="Mark" Color="#0000FF" />
		</ContentControl.Resources>
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup x:Name="Showing">
				<VisualState x:Name="Default" />
				<VisualState x:Name="Hidden">
					<Storyboard>
						<DoubleAnimation Storyboard.TargetName="Panel" Storyboard.TargetProperty="(UIElement.Opacity)"
										 To="0" Duration="0:0:0.25">
							<DoubleAnimation.EasingFunction>
								<SineEase EasingMode="EaseInOut" />
							</DoubleAnimation.EasingFunction>
						</DoubleAnimation>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="Panel" Storyboard.TargetProperty="(UIElement.Visibility)">
							<DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="Collapsed" />
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState x:Name="Shown">
					<Storyboard>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="Panel" Storyboard.TargetProperty="(UIElement.Visibility)">
							<DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
						</ObjectAnimationUsingKeyFrames>
						<DoubleAnimation Storyboard.TargetName="Panel" Storyboard.TargetProperty="(UIElement.Opacity)"
										 To="1" Duration="0:0:0.25">
							<DoubleAnimation.EasingFunction>
								<SineEase EasingMode="EaseInOut" />
							</DoubleAnimation.EasingFunction>
						</DoubleAnimation>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
			<VisualStateGroup x:Name="Marking">
				<VisualState x:Name="Unmarked" />
				<VisualState x:Name="Marked">
					<Storyboard>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="Panel" Storyboard.TargetProperty="(Border.Background)">
							<ObjectAnimationUsingKeyFrames.KeyFrames>
								<DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Mark}" />
								<DiscreteObjectKeyFrame KeyTime="0:0:0.5">
									<DiscreteObjectKeyFrame.Value>
										<SolidColorBrush Color="#FFFF00" />
									</DiscreteObjectKeyFrame.Value>
								</DiscreteObjectKeyFrame>
							</ObjectAnimationUsingKeyFrames.KeyFrames>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="Caption" Storyboard.TargetProperty="Text">
							<DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="Marked" />
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
	</ContentControl>
	<ContentControl x:Name="Host">
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup x:Name="Motion">
				<VisualState x:Name="Rest" />
				<VisualState x:Name="Moved">
					<Storyboard>
						<DoubleAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="(Canvas.Left)"
										 To="100" Duration="0:0:1" />
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="Box" Storyboard.TargetProperty="(UIElement.Opacity)">
							<LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
							<DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0.5" />
							<EasingDoubleKeyFrame KeyTime="0:0:1" Value="0.25">
								<EasingDoubleKeyFrame.EasingFunction>
									<CubicEase EasingMode="EaseIn" />
								</EasingDoubleKeyFrame.EasingFunction>
							</EasingDoubleKeyFrame>
						</DoubleAnimationUsingKeyFrames>
						<ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
										To="#0000FF" Duration="0:0:1" />
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
	</ContentControl>
</StackPanel>
