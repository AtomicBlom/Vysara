<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\build\Vysara.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Shouldly" />
    <!-- Drive Vysara.SourceGen directly (CSharpGeneratorDriver) to unit-test the diagnostics and incremental
         caching that the build-time analyzer path can't exercise (invalid XAML would break this project's own build). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <!-- Turns Vysara.Diagnostics on, as a game opts in, so DiagnosticsTests run its members against real hosts. An AOT
       publish of this app keeps it off: NativeAOT never allows it. Vysara.Tests.DiagnosticsOff runs the configuration a
       game ships with. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Vysara.Diagnostics.Enabled" Value="true" Trim="true" />
  </ItemGroup>

  <!-- Vysara is standalone — only the runtime project is needed (no Loom.Core / Loom.Assets). -->
  <!-- ReferenceOutputAssembly=true on SourceGen so XamlSourceGenerator is referenceable by CSharpGeneratorDriver tests.
       UndefineProperties keeps an AOT publish of this app from AOT-compiling the netstandard2.0 generator (NETSDK1207)
       or building it for the app's RID, as the analyzer reference in build/Vysara.targets does. -->
  <ItemGroup>
    <ProjectReference Include="..\Vysara\Vysara.csproj" />
    <ProjectReference Include="..\Vysara.SourceGen\Vysara.SourceGen.csproj" ReferenceOutputAssembly="true"
                      UndefineProperties="PublishAot;RuntimeIdentifier;SelfContained" />
    <!-- The CPU reference rasterizer is the headless pixel oracle: it renders DrawListData to RGBA8 with the same
         per-kind math (and the RT-stack layer composite) the GPU runs, so group opacity is asserted at the pixel
         level with no GPU. -->
    <ProjectReference Include="..\Vysara.Rasterizer\Vysara.Rasterizer.csproj" />
    <!-- The RoseMCP tap, which RoseTapTests drive as RoseMCP's host would, and the endpoint it is loaded through. The
         tap's copy of the contract's protocol is internal to it, so the tests see only the endpoint's copy, through the
         endpoint's InternalsVisibleTo. -->
    <ProjectReference Include="..\Vysara.RoseTap\Vysara.RoseTap.csproj" />
    <ProjectReference Include="..\Vysara.Diagnostics.Endpoint\Vysara.Diagnostics.Endpoint.csproj" />
    <!-- The MTSDF generator, tested against the font program it bakes: the exact fill its field must reconstruct, and
         the committed default atlas, which must be what baking its fontset produces. -->
    <ProjectReference Include="..\Vysara.Text\Vysara.Text.csproj" />
    <!-- The HarfBuzz shaper, to check OpenType features reach HarfBuzz. Its native library ships for Windows only, so
         those tests skip elsewhere. -->
    <ProjectReference Include="..\Vysara.HarfBuzz\Vysara.HarfBuzz.csproj" />
    <!-- The gallery's pages, each drawn and compared with its golden image (GalleryGoldenTests). -->
    <ProjectReference Include="..\Vysara.Gallery.Pages\Vysara.Gallery.Pages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Vysara\Assets\Fonts\CascadiaCode.ttf" LogicalName="CascadiaCode.ttf" />
    <EmbeddedResource Include="..\Vysara\Assets\Fonts\ui-default.fontset.json" LogicalName="ui-default.fontset.json" />
  </ItemGroup>

  <Import Project="..\build\Vysara.targets" />

</Project>
