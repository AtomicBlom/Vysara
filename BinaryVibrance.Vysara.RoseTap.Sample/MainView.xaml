<?xml version="1.0" encoding="utf-8"?>
<!--
	What the sample hosts for RoseMCP to read through BinaryVibrance.Vysara.RoseTap: named and unnamed elements, same-type siblings, a
	styled TextBlock, the built-in Button with its own C# template, and a Button given a template here, with a
	{TemplateBinding} onto a part.
-->
<StackPanel xmlns="https://github.com/AtomicBlom/Vysara/ui"
			xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			x:Class="BinaryVibrance.Vysara.RoseTap.Sample.MainView"
			Orientation="Vertical">
	<StackPanel.Resources>
		<Style x:Key="Heading" TargetType="TextBlock">
			<Setter Property="FontSize" Value="24" />
		</Style>
	</StackPanel.Resources>
	<TextBlock x:Name="Title" Text="Vysara RoseTap sample" Style="{StaticResource Heading}" />
	<Border Padding="8" Background="#202030">
		<StackPanel Orientation="Horizontal">
			<TextBlock Text="Left" />
			<TextBlock Text="Right" />
		</StackPanel>
	</Border>
	<Button x:Name="Go" Content="Go" />
	<Button x:Name="Custom" Content="Templated" Opacity="0.8">
		<Button.Template>
			<ControlTemplate TargetType="Button">
				<Border x:Name="Chrome" Background="#304060" Padding="6" Opacity="{TemplateBinding Opacity}">
					<ContentPresenter Content="{TemplateBinding Content}" />
				</Border>
			</ControlTemplate>
		</Button.Template>
	</Button>
</StackPanel>
