<Project Sdk="Microsoft.NET.Sdk">

  <!-- loom-msdf: the build-time MTSDF font-atlas baker, packaged as a dotnet tool. A thin CLI over SUIsei.Text;
       all the work lives in the library so the same code runs at runtime. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsAotCompatible>true</IsAotCompatible>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>loom-msdf</ToolCommandName>
    <PackageId>loom-msdf</PackageId>
    <Version>0.1.0</Version>
    <Description>Native cross-platform MTSDF font-atlas generator for SUIsei / Loom (no external binary).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SUIsei.Text\SUIsei.Text.csproj" />
  </ItemGroup>

</Project>
