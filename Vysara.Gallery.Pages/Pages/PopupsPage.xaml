<?xml version="1.0" encoding="utf-8"?>
<!--
	Lists & popups: a ListView, which scrolls itself, with its selection bound TwoWay and ItemClick counted; a ScrollViewer
	whose ViewChanged reports its offset; tooltips on each side of their buttons, one an element and one bound with x:Bind,
	and a ToolTip as it looks; a Button.Flyout holding controls; and a ContextFlyout menu on a card, written as XAML items.
-->
<Border xmlns="https://github.com/AtomicBlom/Vysara/ui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Vysara.Gallery"
        x:Class="Vysara.Gallery.Pages.PopupsPage"
        Padding="28">
	<Border.Resources>
		<SolidColorBrush x:Key="Edge" Color="#3A3F4E" />
		<SolidColorBrush x:Key="Pane" Color="#2B2F3B" />
		<SolidColorBrush x:Key="Ink" Color="#ECEFF6" />
		<SolidColorBrush x:Key="Accent" Color="#78AAFF" />
	</Border.Resources>
	<StackPanel Orientation="Vertical">
		<TextBlock Text="Lists &amp; popups" Style="{x:Static local:GalleryTheme.PageTitle}" />
		<TextBlock Text="Choosing from a list, and what opens over the page: tooltips, flyouts and menus."
		           Style="{x:Static local:GalleryTheme.PageSummary}" />

		<TextBlock Text="ListView" Style="{x:Static local:GalleryTheme.SectionHeading}" />
		<Border Style="{x:Static local:GalleryTheme.Card}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="260" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Border Grid.Column="0" Height="180" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="6">
					<ListView ItemsSource="{x:Bind Tracks}" SelectedIndex="{x:Bind Track, Mode=TwoWay}" IsItemClickEnabled="True"
					          ItemClick="OnTrackClick" Margin="4" />
				</Border>
				<StackPanel Grid.Column="1" Orientation="Vertical" Margin="20,0,0,0">
					<TextBlock Text="{x:Bind TrackLabel, Mode=OneWay}" Style="{x:Static local:GalleryTheme.Body}" Margin="0,0,0,6" />
					<TextBlock Text="{x:Bind ClickLabel, Mode=OneWay}" Style="{x:Static local:GalleryTheme.Note}" Margin="0,0,0,12" />
					<TextBlock Text="Click a row, or Tab in and use the arrows, Home, End, Page Up and Page Down. The list scrolls itself, as WinUI's does."
					           Style="{x:Static local:GalleryTheme.Note}" TextWrapping="Wrap" Margin="0,0,0,12" />
					<TextBlock Text="{x:Bind ScrollLabel, Mode=OneWay}" Style="{x:Static local:GalleryTheme.Note}" Margin="0,0,0,6" />
					<Border Height="64" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="6">
						<ScrollViewer ViewChanged="OnNotesScrolled">
							<TextBlock Text="A ScrollViewer raises ViewChanged as the wheel, a dragged thumb, a key or a pan moves it, or as ScrollToVerticalOffset does; never for what layout does to its offsets. Scroll this note to see it."
							           Style="{x:Static local:GalleryTheme.Note}" TextWrapping="Wrap" Margin="8,6" />
						</ScrollViewer>
					</Border>
				</StackPanel>
			</Grid>
		</Border>

		<TextBlock Text="Tooltips" Style="{x:Static local:GalleryTheme.SectionHeading}" />
		<Border Style="{x:Static local:GalleryTheme.Card}">
			<StackPanel Orientation="Vertical">
				<StackPanel Orientation="Horizontal" Margin="0,0,0,14">
					<Button Content="Below" ToolTipService.ToolTip="Undo the last change (Ctrl Z)" Margin="0,0,8,0" />
					<Button Content="Above" ToolTipService.ToolTip="Opened above the button" ToolTipService.Placement="Top" Margin="0,0,8,0" />
					<Button Content="Right" ToolTipService.ToolTip="Opened to its right" ToolTipService.Placement="Right" Margin="0,0,8,0" />
					<Button Content="Bound" ToolTipService.ToolTip="{x:Bind TrackLabel, Mode=OneWay}" Margin="0,0,8,0" />
					<Button Content="An element">
						<ToolTipService.ToolTip>
							<StackPanel Orientation="Vertical">
								<TextBlock Text="Lap record" FontSize="13" Foreground="{StaticResource Accent}" />
								<TextBlock Text="1:23.456 on the third lap" FontSize="13" Foreground="{StaticResource Ink}" />
							</StackPanel>
						</ToolTipService.ToolTip>
					</Button>
				</StackPanel>
				<TextBlock Text="Rest the pointer on a button; the bound one says which track is chosen. What a tooltip looks like:" TextWrapping="Wrap"
				           Style="{x:Static local:GalleryTheme.Note}" Margin="0,0,0,6" />
				<ToolTip Content="Undo the last change (Ctrl Z)" HorizontalAlignment="Left" />
			</StackPanel>
		</Border>

		<TextBlock Text="Flyout &amp; ContextFlyout" Style="{x:Static local:GalleryTheme.SectionHeading}" />
		<Border Style="{x:Static local:GalleryTheme.Card}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Button Grid.Column="0" Content="Rename..." VerticalAlignment="Top" Margin="0,0,20,0">
					<Button.Flyout>
						<Flyout x:Name="RenameFlyout" Placement="BottomEdgeAlignedLeft">
							<StackPanel Orientation="Vertical">
								<TextBlock Text="A new name" Style="{x:Static local:GalleryTheme.Note}" Margin="0,0,0,6" />
								<TextBox Text="{x:Bind NewName, Mode=TwoWay}" Width="200" Margin="0,0,0,8" />
								<Button Content="Rename" Click="OnRename" HorizontalAlignment="Right" />
							</StackPanel>
						</Flyout>
					</Button.Flyout>
				</Button>
				<Border Grid.Column="1" Background="{StaticResource Pane}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="6" Padding="14,10,14,12">
					<Border.ContextFlyout>
						<MenuFlyout>
							<MenuFlyoutItem Text="Duplicate" Click="OnDuplicate" />
							<MenuFlyoutItem Text="Reverse" Click="OnReverse" />
							<MenuFlyoutItem Text="Forget" Click="OnForget" />
						</MenuFlyout>
					</Border.ContextFlyout>
					<StackPanel Orientation="Vertical">
						<TextBlock Text="{x:Bind TrackName, Mode=OneWay}" Style="{x:Static local:GalleryTheme.Body}" Margin="0,0,0,4" />
						<TextBlock Text="{x:Bind MenuLabel, Mode=OneWay}" Style="{x:Static local:GalleryTheme.Note}" />
					</StackPanel>
				</Border>
			</Grid>
		</Border>
	</StackPanel>
</Border>
