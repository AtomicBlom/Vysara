<?xml version="1.0" encoding="utf-8"?>
<!--
	Text: shaping through HarfBuzz (programming ligatures resolve to their contextual glyphs), text effects drawn from the
	atlas's true-distance channel, and the type scale.
-->
<Border xmlns="https://github.com/AtomicBlom/Vysara/ui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vysara="https://github.com/AtomicBlom/Vysara/extensions"
        xmlns:local="using:Vysara.Gallery"
        x:Class="Vysara.Gallery.Pages.TextPage"
        Padding="28">
	<StackPanel Orientation="Vertical">
		<TextBlock Text="Text" Style="{x:Static local:GalleryTheme.PageTitle}" />
		<TextBlock Text="Shaped by HarfBuzz and drawn from a distance field: sharp at any size."
		           Style="{x:Static local:GalleryTheme.PageSummary}" />

		<TextBlock Text="Shaping" Style="{x:Static local:GalleryTheme.SectionHeading}" />
		<Border Style="{x:Static local:GalleryTheme.Card}">
			<StackPanel Orientation="Vertical">
				<TextBlock Text="-&gt; =&gt; != == &gt;= &lt;= :: |&gt; //" FontSize="22" Foreground="#9FE0A0" Margin="0,0,0,6" />
				<TextBlock Text="Cascadia Code's ligatures, from its GSUB table, through HarfBuzz." Style="{x:Static local:GalleryTheme.Note}" />
			</StackPanel>
		</Border>

		<TextBlock Text="Text effects" Style="{x:Static local:GalleryTheme.SectionHeading}" />
		<Border Style="{x:Static local:GalleryTheme.Card}">
			<StackPanel Orientation="Vertical">
				<!-- A gradient outline over a soft cyan shadow, sized in EM -->
				<TextBlock Text="LAP 3  1:23.456" FontSize="26" Foreground="#ECEFF6" Margin="0,0,0,6"
				           vysara:TextEffects.OutlineThickness="0.07"
				           vysara:TextEffects.ShadowOffset="0.06,0.08" vysara:TextEffects.ShadowSoftness="0.3"
				           vysara:TextEffects.ShadowBrush="#B040C8FF">
					<vysara:TextEffects.OutlineBrush>
						<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
							<GradientStop Color="#FF4D6D" Offset="0" />
							<GradientStop Color="#FFB000" Offset="1" />
						</LinearGradientBrush>
					</vysara:TextEffects.OutlineBrush>
				</TextBlock>
				<TextBlock Text="An outline and a shadow, drawn from the atlas's true-distance channel." Style="{x:Static local:GalleryTheme.Note}" />
			</StackPanel>
		</Border>

		<TextBlock Text="Type scale" Style="{x:Static local:GalleryTheme.SectionHeading}" />
		<Border Style="{x:Static local:GalleryTheme.Card}">
			<StackPanel Orientation="Vertical">
				<TextBlock Text="12px - The quick brown fox" FontSize="12" Foreground="#ECEFF6" Margin="0,0,0,4" />
				<TextBlock Text="16px - The quick brown fox" FontSize="16" Foreground="#ECEFF6" Margin="0,0,0,4" />
				<TextBlock Text="22px - The quick brown fox" FontSize="22" Foreground="#ECEFF6" Margin="0,0,0,4" />
				<TextBlock Text="30px - The quick brown fox" FontSize="30" Foreground="#ECEFF6" />
			</StackPanel>
		</Border>
	</StackPanel>
</Border>
