<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\build\Vysara.props" />

  <!-- Vysara as a game ships it: BinaryVibrance.Vysara.Diagnostics never turned on. BinaryVibrance.Vysara.Tests turns the switch on for its whole
       process, and a process can't turn it off again, so the off path runs here, in a process of its own. It references
       the endpoint as a debug build would, to show that starting it does nothing while the switch is off. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BinaryVibrance.Vysara\BinaryVibrance.Vysara.csproj" />
    <ProjectReference Include="..\BinaryVibrance.Vysara.Diagnostics.Endpoint\BinaryVibrance.Vysara.Diagnostics.Endpoint.csproj" />
  </ItemGroup>

  <Import Project="..\build\Vysara.targets" />

</Project>
