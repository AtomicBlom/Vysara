<?xml version="1.0" encoding="utf-8"?>
<!--
	Live x:Bind end to end: a bool shown as a Visibility, function bindings on the page and in a template, TwoWay
	IsChecked and a Slider's double written back to a float source that clamps it, and a DataTemplate whose bindings follow
	their item (a radio-like choice, a function of its level) with a template nested in it over x:String items.
-->
<StackPanel xmlns="https://github.com/AtomicBlom/Vysara/ui"
			xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			xmlns:local="using:BinaryVibrance.Vysara.Tests.Sample"
			x:Class="BinaryVibrance.Vysara.Tests.Sample.LiveBindingView">
	<TextBlock x:Name="Banner" Text="Error" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
	<TextBlock x:Name="Percent" Text="{x:Bind local:LiveFormat.Percent(ViewModel.Level), Mode=OneWay}" />
	<TextBlock x:Name="Summary" Text="{x:Bind local:LiveFormat.Pair(ViewModel.Selected.Name, ViewModel.Level), Mode=OneWay, FallbackValue=none}" />
	<ToggleButton x:Name="Loop" IsChecked="{x:Bind ViewModel.Loop, Mode=TwoWay}" />
	<Slider x:Name="Gain" Minimum="0" Maximum="1" Value="{x:Bind ViewModel.Level, Mode=TwoWay}" />
	<ItemsControl x:Name="Choices" ItemsSource="{x:Bind ViewModel.Choices}">
		<ItemsControl.ItemTemplate>
			<DataTemplate x:DataType="local:LiveChoice">
				<StackPanel>
					<ToggleButton IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
						<TextBlock Text="{x:Bind Name}" />
					</ToggleButton>
					<TextBlock Text="{x:Bind local:LiveFormat.Percent(Level), Mode=OneWay}" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
					<ItemsControl ItemsSource="{x:Bind Tags}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="x:String">
								<TextBlock Text="{x:Bind}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</DataTemplate>
		</ItemsControl.ItemTemplate>
	</ItemsControl>
</StackPanel>
