<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vysara's RoseMCP tap: one AnyCPU assembly a RoseMCP host drops into its taps folder and loads into a running game
       through the diagnostics endpoint (BinaryVibrance.Vysara.Diagnostics.Endpoint, which the game starts), where it answers RoseMCP's
       live UI tools over the host's pipe. It reaches Vysara only through the public BinaryVibrance.Vysara.Diagnostics API and runs only
       inside the game, never in RoseMCP.

       Vysara is referenced and not copied beside the tap: the endpoint hands the tap the game's own Vysara, so a copy in
       the drop-in folder would never be used. The tap compiles its own internal copy of the contract's protocol, which
       never clashes with the copy compiled into the endpoint. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BinaryVibrance.Vysara\BinaryVibrance.Vysara.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\external\RoseMcp.Tap\Protocol\*.cs" Link="RoseMcp.Tap\Protocol\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="RequireRoseMcpTap" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildThisFileDirectory)..\external\RoseMcp.Tap\Protocol\TapWire.cs')">
    <Error Text="BinaryVibrance.Vysara.RoseTap compiles the RoseMCP tap contract from the external/RoseMcp.Tap submodule, which is not checked out. Run: git submodule update --init external/RoseMcp.Tap" />
  </Target>

  <!-- The magnifier reads the UI's pixels with BinaryVibrance.Vysara.Rasterizer's CPU copy of the UI shader, compiled in so the tap stays
       one file; internal, so it never clashes with a game's own reference to BinaryVibrance.Vysara.Rasterizer. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);VYSARA_RASTERIZER_INTERNAL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\BinaryVibrance.Vysara.Rasterizer\SoftwareRasterizer.cs;..\BinaryVibrance.Vysara.Rasterizer\Texture.cs" Link="Rasterizer\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
