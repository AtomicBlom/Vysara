<Project>

  <!--
    Central Package Management for the Loom solution. Package versions live here as <PackageVersion>; the
    individual projects carry version-less <PackageReference> items. MSBuild imports the nearest
    Directory.Packages.props walking up from each project — the vendored submodule under external/ opts out via
    its own external/Directory.Packages.props (it pins its own Silk.NET versions and must not be governed here).
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Image decoding">
    <PackageVersion Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <ItemGroup Label="Source generation">
    <!-- Roslyn for the Vysara.SourceGen XAML incremental generator (build-time analyzer, PrivateAssets=all). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- Win32 P/Invoke generator for the software-rendered Win32 gallery host (build-time analyzer, PrivateAssets=all). -->
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.298" />
  </ItemGroup>

  <ItemGroup Label="Text shaping (HarfBuzz — the optional Vysara.HarfBuzz adapter; native assets are per-RID)">
    <PackageVersion Include="HarfBuzzSharp" Version="14.2.0" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Win32" Version="14.2.0" />
  </ItemGroup>

  <ItemGroup Label="Tests (TUnit on Microsoft.Testing.Platform + Shouldly assertions)">
    <PackageVersion Include="TUnit" Version="1.56.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

</Project>
