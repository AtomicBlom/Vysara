<Project Sdk="Microsoft.NET.Sdk">

  <!-- XAML -> typed control-tree generator wiring (registers *.xaml as AdditionalFiles + the analyzer ref). -->
  <Import Project="..\build\Vysara.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NativeAOT gate: turns on the trim + AOT Roslyn analyzers so any reflection or AOT-unsafe pattern
         surfaces as a build warning. The UI runtime is NAOT-clean by design (compiled x:Bind, typed DP
         delegates, no Activator/MethodInfo). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>BinaryVibrance.Vysara</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Authors>AtomicBlom</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AtomicBlom/Vysara</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AtomicBlom/Vysara</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Retained-mode WinUI-like control tree and compositor for .NET. NativeAOT-clean, XAML-driven, with an incremental Roslyn source generator bundled in this package.</Description>
    <PackageTags>ui;xaml;winui;gamedev;dotnet;naot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSymbols>true</IncludeSymbols>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- Vysara is standalone — no Loom.Core or Loom.Assets reference. The only external dependency is
       StbImageSharp for decoding the embedded MTSDF font atlas PNG. Engine glue lives in Loom.UI.Vysara. -->
  <ItemGroup>
    <PackageReference Include="StbImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BinaryVibrance.Vysara.Tests" />
  </ItemGroup>

  <!-- The engine's default baked font: the MTSDF atlas page + its JSON layout, embedded so FontAtlas.LoadEmbeddedDefault
       resolves them with no loose files. Explicit LogicalName because the filenames carry dots.
       A committed bake, not a build output: build/Vysara.Fonts.targets runs BinaryVibrance.Vysara.Text.Tool, which depends on this
       project, so this project's own build cannot run it. The pair is what baking ui-default.fontset.json produces
       (BinaryVibrance.Vysara.Tests holds it to that); after editing the fontset or the generator, re-bake it by running
       BinaryVibrance.Vysara.Text.Tool on the fontset with "-o BinaryVibrance.Vysara/Assets/Fonts" (the full command is in MsdfGenerationTests). -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\ui-default.font.json" LogicalName="ui-default.font.json" />
    <EmbeddedResource Include="Assets\Fonts\ui-default.0.png" LogicalName="ui-default.0.png" />
    <None Include="Assets\Fonts\CascadiaCode.ttf" />
    <None Include="Assets\Fonts\CascadiaCode-LICENSE.txt" />
  </ItemGroup>

  <Import Project="..\build\Vysara.targets" />

  <!-- NuGet packaging: bundle BinaryVibrance.Vysara.SourceGen.dll in analyzers/dotnet/cs so consumers get both the runtime
       and the XAML incremental generator from a single <PackageReference Include="BinaryVibrance.Vysara" />.
       The generator is already built as a dependency (via Vysara.targets' ProjectReference); this target just
       hoists its netstandard2.0 output into the package at the right path. -->
  <ItemGroup>
    <None Include="..\BinaryVibrance.Vysara.SourceGen\bin\$(Configuration)\netstandard2.0\BinaryVibrance.Vysara.SourceGen.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- Consumer-facing build targets: registers *.xaml as AdditionalFiles so the bundled generator sees them. NuGet
         imports a package's build\<package ID>.targets alone, so it is packed under the package's ID. -->
    <None Include="pkg\build\Vysara.targets"
          Pack="true" PackagePath="build\BinaryVibrance.Vysara.targets" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    <!-- The tessellators derive from libtess2 (SGI Free Software License B) and earcut (ISC); their notices ship too. -->
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

</Project>
