<?xml version="1.0" encoding="utf-8"?>
<!--
	Controls: Command-bound and event Buttons, a MenuFlyout opened from code-behind, CheckBoxes and ToggleButtons, Sliders
	(one TwoWay-bound through a three-segment x:Bind path), and a TwoWay-bound TextBox.
-->
<Border xmlns="https://github.com/AtomicBlom/SUIsei/ui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SUIsei.Gallery"
        x:Class="SUIsei.Gallery.Pages.ControlsPage"
        Padding="28">
	<StackPanel Orientation="Vertical">
		<TextBlock Text="Controls" Style="{x:Static local:GalleryTheme.PageTitle}" />
		<TextBlock Text="WinUI's controls in their built-in looks, driven by events, commands and x:Bind."
		           Style="{x:Static local:GalleryTheme.PageSummary}" />

		<TextBlock Text="Buttons, commands &amp; menu" Style="{x:Static local:GalleryTheme.SectionHeading}" />
		<Border Style="{x:Static local:GalleryTheme.Card}">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<Button Content="Click me" Click="OnClick" Margin="0,0,8,0" />
				<Button Content="Greet (Command)" Command="{x:Bind GreetCommand}" Margin="0,0,8,0" />
				<Button Content="Reset" Click="OnReset" Margin="0,0,8,0" />
				<Button Content="Menu..." Click="OnShowMenu" Margin="0,0,8,0" />
				<TextBlock x:Name="ClickCounter" Text="Clicks: 0" Style="{x:Static local:GalleryTheme.Body}" Margin="8,0,0,0" VerticalAlignment="Center" />
			</StackPanel>
		</Border>

		<TextBlock Text="CheckBoxes &amp; toggle buttons" Style="{x:Static local:GalleryTheme.SectionHeading}" />
		<Border Style="{x:Static local:GalleryTheme.Card}">
			<StackPanel Orientation="Vertical">
				<CheckBox Content="Enable shadows" IsChecked="true" Margin="0,0,0,6" />
				<CheckBox Content="Vsync" Margin="0,0,0,6" />
				<CheckBox Content="Experimental (three-state)" IsThreeState="true" Margin="0,0,0,12" />
				<StackPanel Orientation="Horizontal">
					<ToggleButton Content="Bold" IsChecked="true" Margin="0,0,8,0" />
					<ToggleButton Content="Italic" Margin="0,0,8,0" />
					<ToggleButton Content="Underline" />
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- The first slider is TwoWay-bound to Render.Bloom.Intensity, a three-segment path, and the label above it
		     OneWay-binds the formatted echo Render.Bloom.IntensityLabel -->
		<TextBlock Text="Sliders &amp; nested x:Bind" Style="{x:Static local:GalleryTheme.SectionHeading}" />
		<Border Style="{x:Static local:GalleryTheme.Card}">
			<StackPanel Orientation="Vertical">
				<TextBlock Text="{x:Bind Render.Bloom.IntensityLabel, Mode=OneWay}" Style="{x:Static local:GalleryTheme.Body}" Margin="0,0,0,6" />
				<Slider Minimum="0" Maximum="1" StepFrequency="0.01" Value="{x:Bind Render.Bloom.Intensity, Mode=TwoWay}" Margin="0,0,0,14" />
				<TextBlock Text="Exposure" Style="{x:Static local:GalleryTheme.Note}" Margin="0,0,0,4" />
				<Slider Minimum="0" Maximum="100" Value="40" />
			</StackPanel>
		</Border>

		<TextBlock Text="Text input" Style="{x:Static local:GalleryTheme.SectionHeading}" />
		<Border Style="{x:Static local:GalleryTheme.Card}">
			<StackPanel Orientation="Vertical">
				<TextBox Text="{x:Bind Name, Mode=TwoWay}" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8" />
				<TextBlock Text="{x:Bind Greeting, Mode=OneWay}" Style="{x:Static local:GalleryTheme.Body}" />
			</StackPanel>
		</Border>
	</StackPanel>
</Border>
